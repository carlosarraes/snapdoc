<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- android:isLightTheme is what the WebView reads to decide whether to
         report prefers-color-scheme: dark to the document, so the light/night
         pair here is what makes hosted docs follow the system theme. -->
    <style name="Theme.Snapdoc" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:statusBarColor">#f6f8fa</item>
        <item name="android:navigationBarColor">#f6f8fa</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#f6f8fa</item>
    </style>
</resources>
